<% if resource.present? && resource.errors.any? %>
  <%= content_tag :div, class: 'alert alert-danger resource-errors', data: { resource_id: resource.id } do %>
    <h2>
      <%= I18n.t('helpers.shared.errors.header', count: resource.errors.count) %>
    </h2>
  
    <ul>
      <% resource.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  <% end %>
<% end %>


