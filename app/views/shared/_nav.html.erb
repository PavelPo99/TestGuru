<nav class="navbar navbar-expand-lg navbar-dark shadow-sm bg-dark">
  <div class="container">
    <%= link_to root_path, class: 'navbar-brand d-flex align-items-center' do %>
      <span class="fw-bold">TestGuru</span>
    <% end %>
    
  <div class="collapse navbar-collapse" id="navbarContent">
      <ul class="navbar-nav me-auto mb-2 mb-lg-0">
        <% if current_user.is_a?(Admin) %>
          <li class="nav-item">
            <%= link_to 'Admin Panel', admin_tests_path, class: 'nav-link' %>
          </li>
          <li class="nav-item">
            <%= link_to 'Gists', admin_gists_index_path, class: 'nav-link' %>
          </li>
        <% end %>
      </ul>  
      <span class="navbar-text">
      <% unless current_user.is_a?(Admin) %>
        
        <% if user_signed_in? %>
          Welcome, <b><%= current_user.email %></b> <%= link_to t('.guru'), root_path %> |
          <%= link_to t('helpers.link.log_out'), destroy_user_session_path,  data: { turbo_method: :delete,  turbo_confirm: t('helpers.data.are_you_sure') }, class: 'btn btn-light me-2 text-dark' %>

        <% else %>  
          <div class="btn-group" role="group">
            <%= link_to t('helpers.link.log_in'), new_user_session_path, class: 'btn btn-light me-2 text-dark' %>
            <%= link_to t('helpers.link.sign_up'), new_user_registration_path, class: 'btn btn-light text-dark' %>
          </div>
        <% end %>
      <% end %>
    </span>
  </div>
</nav>


<style>
  .navbar {
    padding: 0.75rem 1rem;
    transition: all 0.3s ease;
  }
  
  .navbar-brand {
    font-size: 1.25rem;
    transition: all 0.3s ease;
  }
  
  .nav-link {
    position: relative;
    padding: 0.5rem 1rem;
  }
  
  .nav-link:after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 1rem;
    right: 1rem;
    height: 2px;
    background: rgba(255, 255, 255, 0.5);
    transform: scaleX(0);
    transition: transform 0.3s ease;
  }
  
  .nav-link:hover:after {
    transform: scaleX(1);
  }
  
</style>


