<tr class="col-card">
  <td class="aling-middle">
    <%= content_tag :span, test.title, class: "test-title", data: { test_id: test.id } %>
    <%= render 'form_inline', test: test == @test? @test : test %>
  </td>
  <td class="aling-middle"><%= test.category.title %></td>
  <td class="aling-middle"><%= test.level %></td>
  <td class="aling-middle"><%= test.author.first_name %></td>
  <td class="aling-middle"><%= test.questions.count %></td>

  <td class="aling-middle">  
    <%= button_to t('helpers.button.show'), admin_test_path(test), method: :get, params: { lang: params[:lang] }, class: 'btn btn-outline-primary w-80', as: "style" %>
  </td>
  <td class="aling-middle">  
    <%= button_to t('helpers.button.edit'), 
                  edit_admin_test_path(test), 
                  method: :get, 
                  params: { lang: params[:lang] }, 
                  class: 'btn btn-outline-primary w-80 form-inline-link',
                  data: { test_id: test.id, cancel: t('helpers.form_inline.cancel'), edit: t('helpers.form_inline.edit') }  %>
  </td>
  <td class="aling-middle">  
    <%= button_to t('helpers.button.delete'), 
              admin_test_path(test), 
              method: :delete,
              form: { 
                data: { 
                  turbo_confirm: t('helpers.data.are_you_sure') 
                } 
              },
              class: 'btn btn-outline-primary w-80' %>
  </td>  
</tr>
