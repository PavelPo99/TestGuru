<%= form_with(model: [:admin, @badge]) do |form| %>
  <% if @badge.errors.any? %>
    <div class="alert alert-danger">
      <h4><%= pluralize(@badge.errors.count, "error") %> prohibited this badge from being saved:</h4>
      <ul>
        <% @badge.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="form-group">
    <%= form.label t('admin.badge.edit.title') %>
    <%= form.text_field :title, class: 'form-control' %>
  </div>

  <div class="form-group">
    <%= form.label t('admin.badge.edit.text') %>
    <%= form.text_area :text, class: 'form-control' %>
  </div>

  <div class="form-group">
    <%= form.label t('admin.badge.edit.rule') %>
    <%= form.select :rule, 
                    options_for_select(
                      Badge.rules_with_descriptions.map { |k, v| [v, k.to_s] },
                      @badge.rule
                    ),
                    {}, 
                    class: 'form-control' %>
  </div>

  <div class="form-group">
    <%= form.label t('admin.badge.edit.image_url') %>
    <%= form.text_field :image_url, class: 'form-control', placeholder: 'URL или путь к изображению' %>
  </div>

  <div class="actions">
    <%= form.submit class: 'btn btn-primary' %>
  </div>
<% end %>
