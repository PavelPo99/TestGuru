<h1><%= @badge.title %></h1>

<div class="card">
  <div class="card-body">
    <% if @badge.image_url.present? %>
      <div class="text-center mb-3">
        <%= image_tag @badge.image_url, class: 'img-thumbnail', style: 'max-height: 200px' %>
      </div>
    <% end %>

    <p><strong><%= t('admin.badge.show.text') %>:</strong> <%= @badge.text %></p>
    <p><strong><%= t('admin.badge.show.rule') %>:</strong> <%= @badge.rule %></p>
    <p><strong><%= t('admin.badge.show.users_count') %>:</strong> <%= @badge.users.count %></p>

    <div class="mt-3">
      <%= link_to  t('helpers.button.edit'), edit_admin_badge_path(@badge), class: 'btn btn-primary' %>
      <%= link_to t('helpers.link.back'), admin_badges_path, class: 'btn btn-secondary' %>
    </div>
  </div>
</div>
